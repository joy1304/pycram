<?xml version="1.0"?>
<robot name="fuselage">
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.4"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.4"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="tail_cone_1">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.1"/>
      </geometry>
       <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.1"/>
      </geometry>
    </collision>
     <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="tail_cone_2">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.1"/>
      </geometry>
       <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.1"/>
      </geometry>
    </collision>
     <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
    <link name="tail_cone_3">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
       <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
    </collision>
     <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="base_to_cone_1" type="fixed">
    <parent link="base_link"/>
    <child link="tail_cone_1"/>
    <origin xyz="0 0 -0.25"/>
  </joint>

  <joint name="cone_1_to_cone_2" type="fixed">
    <parent link="tail_cone_1"/>
    <child link="tail_cone_2"/>
    <origin xyz="0 0 -0.1"/>
  </joint>
  
    <joint name="cone_2_to_cone_3" type="fixed">
    <parent link="tail_cone_2"/>
    <child link="tail_cone_3"/>
    <origin xyz="0 0 -0.075"/>
  </joint>
</robot>
